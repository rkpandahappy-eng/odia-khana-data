{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recipes.schema.json",
  "title": "data/recipes.json – all recipes",
  "type": "array",
  "items": { "$ref": "#/definitions/recipe" },
  "definitions": {
    "text": { "$ref": "localized_text.schema.json" },
    "recipe": {
      "type": "object",
      "required": [
        "id", "slug", "name", "description", "category_id", "food_type",
        "prep_time_minutes", "cook_time_minutes", "difficulty", "default_servings",
        "ingredients", "instructions", "published_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "Never change after publishing" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "category_id": { "type": "string", "minLength": 1 },
        "food_type": { "enum": ["vegetarian", "non_vegetarian"] },
        "prep_time_minutes": { "type": "integer", "minimum": 0 },
        "cook_time_minutes": { "type": "integer", "minimum": 0 },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "default_servings": { "type": "integer", "minimum": 1 },
        "cuisine": { "$ref": "#/definitions/text" },
        "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ingredient" } },
        "instructions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } },
        "tips": { "type": "array", "items": { "$ref": "#/definitions/text" } },
        "serving_suggestion": { "$ref": "#/definitions/text" },
        "image": { "type": ["string", "null"], "description": "Path like images/recipes/dalma.webp" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "is_featured": { "type": "boolean" },
        "is_published": { "type": "boolean" },
        "is_verified": { "type": "boolean", "description": "true only after quantities and steps were checked" },
        "published_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "video": { "$ref": "#/definitions/video" }
      }
    },
    "video": {
      "type": "object",
      "description": "Making video on YouTube (a Short or a normal video), played inside the app",
      "required": ["youtube_id", "credit"],
      "additionalProperties": false,
      "properties": {
        "youtube_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$", "description": "The id from youtube.com/shorts/ID or watch?v=ID" },
        "credit": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Channel that made the video, shown as Video by ..." },
        "title": { "type": "string" }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["id", "name", "unit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/definitions/text" },
        "quantity": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "unit": {
          "enum": ["cup", "tbsp", "tsp", "g", "kg", "ml", "litre", "piece", "pinch", "handful", "to_taste", "as_required"]
        },
        "scalable": { "type": "boolean" },
        "note": { "$ref": "#/definitions/text" }
      },
      "if": { "properties": { "unit": { "enum": ["to_taste", "as_required"] } } },
      "else": { "required": ["quantity"], "properties": { "quantity": { "type": "number" } } }
    },
    "step": {
      "type": "object",
      "required": ["step", "text"],
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "text": { "$ref": "#/definitions/text" },
        "image": { "type": ["string", "null"] },
        "timer_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "tip": { "$ref": "#/definitions/text" }
      }
    }
  }
}
